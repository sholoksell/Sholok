# Sholok Super Admin — Server Environment
# Copy to .env and fill in real values. NEVER commit .env to git.

PORT=5555
NODE_ENV=production

DB_HOST=localhost
DB_PORT=3306
DB_USER=superadmin_user
DB_PASS=CHANGE_ME_strong_password_here
DB_NAME=superadmin_db

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret_here

ALLOWED_ORIGINS=https://superconsole.sholok.com
