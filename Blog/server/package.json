{
  "name": "sholok-blog-server",
  "version": "2.0.0",
  "description": "Sholok Blog — Backend API + Admin Panel (MySQL)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "install:admin": "cd admin && npm install",
    "build:admin": "cd admin && npm run build",
    "setup": "npm install && npm run install:admin && npm run build:admin"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.23.3",
    "slugify": "^1.6.6",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
